# ---------------------------------------------------------------------------
# TaskFlow environment
#
# 1. Copy this file:      cp .env.example .env.local
# 2. Supabase dashboard → Project Settings → API (or "API Keys")
# 3. Paste the two values below. Restart `npm run dev` after editing.
#
# .env.local is git-ignored. NEVER commit real keys.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL= 

# The PUBLIC key — labelled "anon public" or "Publishable key" in the dashboard.
# Safe to expose in the browser: Row Level Security is what actually protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOTE: the "service_role" / "secret" key must NEVER appear in this file or in
# any NEXT_PUBLIC_* variable. It bypasses Row Level Security entirely.
